{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${env:GODOT_HOME}/4.6.1/Godot_v4.6.1-stable_mono_win64.exe",
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"stopAtEntry": false,
			"args": ["--path", "${workspaceFolder}"]
		},
		{
			"name": "Launch (Select Scene)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${env:GODOT_HOME}/4.6.1/Godot_v4.6.1-stable_mono_win64.exe",
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"stopAtEntry": false,
			"args": [
				"--path",
				"${workspaceFolder}",
				"${command:godot.csharp.getLaunchScene}"
			]
		},
		{
			"name": "Launch Editor",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${env:GODOT_HOME}/4.6.1/Godot_v4.6.1-stable_mono_win64.exe",
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"stopAtEntry": false,
			"args": ["--path", "${workspaceFolder}", "--editor"]
		},
		{
			"name": "Attach to Process",
			"type": "coreclr",
			"request": "attach"
		}
	]
}
